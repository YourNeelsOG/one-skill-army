# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/
.venv/
venv/

# Secrets and local-only env files (never publish)
.env
.env.local
.env.*
!.env.example

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/


# One Skill Army per-project runtime data (users generate their own with
# `osa index .`; nothing machine-specific belongs in the repo).
.osa/

# External graphify tool output (not part of this pack)
graphify-out/

# Installer backups
*.bak
*.bak.*

# Note: skills/one-skill-army/osa.pyz IS committed on purpose (the bundled
# engine ships with the skills); it is regenerated by scripts/build-osa.py.
